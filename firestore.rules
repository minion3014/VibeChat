rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isVerified() {
      return isSignedIn();
    }

    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && (data.email == null || (data.email is string && data.email.size() <= 100))
        && data.lastSeen is timestamp;
    }

    function isValidMessage(data) {
      return data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() > 0
        && (data.senderPhoto == null || (data.senderPhoto is string && data.senderPhoto.size() <= 500))
        && data.createdAt == request.time;
    }

    function isValidMessageDeletion(data) {
      return data.text == 'Tin nhắn này đã xóa'
        && data.isDeleted == true
        && data.updatedAt == request.time;
    }

    function isValidChat(data) {
      return data.members is list && data.members.size() >= 2 && data.members.size() <= 20
        && data.members.hasAny([request.auth.uid])
        && data.get('type', 'private') in ['private', 'group']
        && (data.get('name', null) == null || (data.name is string && data.name.size() <= 100))
        && (data.get('lastMessage', null) == null || (data.lastMessage is string && data.lastMessage.size() <= 1000))
        && (data.get('lastReadAt', null) == null || data.lastReadAt is map)
        && data.updatedAt == request.time;
    }

    // --- Collections ---

    // Users: Profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerified() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isVerified() && userId == request.auth.uid && isValidUser(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastSeen', 'email']);
    }

    // Chats: Rooms
    match /chats/{chatId} {
      allow read: if isSignedIn() && resource.data.members.hasAny([request.auth.uid]);
      allow create: if isVerified() && isValidChat(incoming());
      allow update: if isVerified() && existing().members.hasAny([request.auth.uid]) 
                    && (
                      (isValidChat(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'name', 'type', 'members', 'lastReadAt']))
                      || 
                      (incoming().diff(existing()).affectedKeys().hasOnly(['lastReadAt']) && incoming().lastReadAt is map)
                    );
      allow delete: if isVerified() && existing().members.hasAny([request.auth.uid]);
      
      // Messages within a chat
      match /messages/{msgId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.members.hasAny([request.auth.uid]);
        allow create: if isVerified() && get(/databases/$(database)/documents/chats/$(chatId)).data.members.hasAny([request.auth.uid])
                      && isValidMessage(incoming());
        allow update: if isVerified() 
                      && existing().senderId == request.auth.uid
                      && !existing().get('isDeleted', false)
                      && isValidMessageDeletion(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isDeleted', 'updatedAt']);
        allow delete: if isVerified() && existing().senderId == request.auth.uid;
      }
    }

    // Messages: Global Chat stream
    match /messages/{messageId} {
      // Secure List Queries
      allow list: if isSignedIn();
      allow get: if isSignedIn();

      allow create: if isVerified() && isValidMessage(incoming());
      allow update: if isVerified() 
                    && existing().senderId == request.auth.uid
                    && !existing().get('isDeleted', false)
                    && isValidMessageDeletion(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isDeleted', 'updatedAt']);
      allow delete: if isVerified() && existing().senderId == request.auth.uid;
    }
  }
}
